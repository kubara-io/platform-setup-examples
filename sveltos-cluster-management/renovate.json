{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Generated by kubara init.",
    "This configuration adds support for updating kubara catalog OCI references."
  ],
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update kubara catalog OCI references",
      "managerFilePatterns": [
        "/^config\\.yaml$/"
      ],
      "matchStrings": [
        "oci:\\/\\/(?<depName>[^\\s\"'@]+):(?<currentValue>[^\\s/:\"'@]+)(?:$|[\\s\"'#,}\\]])"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>0|[1-9]\\d*)\\.(?<minor>0|[1-9]\\d*)\\.(?<patch>0|[1-9]\\d*)$"
    }
  ]
}
